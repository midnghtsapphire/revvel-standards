# Revvel Standards — Environment Variable Reference
# ─────────────────────────────────────────────────
# NEVER commit a real .env file to git.
# This file documents variable NAMES only — no real values.
# All secrets are stored in HashiCorp Vault (see VAULT_AGENT_STANDARD.md).
#
# NOTE ON GITHUB ACTIONS SECRETS:
#   No workflow or script in this repo ever deletes GitHub Actions secrets.
#   If a secret appears "missing" in a downstream repo, it was never
#   provisioned there — Actions secrets are scoped per-repository and do
#   not propagate with workflow files. See docs/SECRETS_MANAGEMENT.md for a
#   recovery helper (scripts/provision-repo-secrets.sh).
#
# Vault server: https://vault.freedomangelcorps.com
# Path convention: revvel/shared/<category>/<service>
#                  revvel/apps/<app>/<env>/<service>
#
# To retrieve a secret:
#   vault kv get -field=api_key revvel/shared/llm/openai
# ─────────────────────────────────────────────────

# ─────────────────────────────────────────────
# AI / LLM
# Vault path: revvel/shared/llm/openai
# ─────────────────────────────────────────────
OPENAI_API_KEY=

# Vault path: revvel/shared/llm/anthropic
ANTHROPIC_API_KEY=

# Vault path: revvel/shared/llm/groq
GROQ_API_KEY=

# Vault path: revvel/shared/llm/xai
# Grok (xAI) — MOTU Lead oversight for the BNAT knowledge sheaf
# (see standards/BNAT_SHEAF_STANDARD.md and docs/bnatsheaf/).
# XAI_API_KEY is the canonical name; GROK_API_KEY is an accepted alias.
# GitHub Actions inject these as environment variables via the standard
# secrets: -> env: pattern used by other agent workflows.
XAI_API_KEY=
GROK_API_KEY=

# Vault path: revvel/shared/llm/openrouter
# Used by the "openrouter-assignee" workflow (see
# docs/OPENROUTER_ASSIGNEE_PROCESS.md) so the OpenRouter-backed orchestrator
# is the first line of sight on every new issue / PR, and by the 24/7 Ralph
# cron loop that sweeps open issues & PRs.
# Also used by the OpenRouter model routing module (see
# docs/OPENROUTER_MODEL_ROUTING.md) for task-based model selection with
# automatic fallback chains.
OPENROUTER_API_KEY=

# Vault path: revvel/shared/llm/cursor
# Used as backup to Devin AI when Devin hits rate limits or is unavailable.
# The agent-fallback workflow automatically switches to Cursor when Devin fails.
CURSOR_API_KEY=

# Vault path: revvel/shared/llm/devin
# Primary AI coding agent. Falls back to Cursor when rate limits are reached.
# See docs/AGENT_FALLBACK_PROCESS.md for the complete fallback chain.
DEVIN_API_KEY=

# Vault path: revvel/shared/llm/jules
# Used by .github/workflows/jules-invoke.yml to perform deep research on every
# new [WR] issue before the OpenRouter coder applies any code changes.
JULES_API_KEY=

# Vault path: revvel/shared/llm/huggingface
# Hugging Face Hub token (https://huggingface.co/settings/tokens). Grants
# authenticated access to models, datasets, and Inference API. Referenced by
# the CUDA execution-model Grid's prior-art notes (BytedTsinghua CUDA-Agent-Ops-6K)
# for future fine-tune work. Not required to ship any current Block; register
# entry only reserves the environment-variable name.
# Token format: hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HUGGINGFACE_TOKEN=

# ─────────────────────────────────────────────
# WR / PR CONTROL PLANE — Composio, Firecrawl, Tavily, Obot, FastMCP
# Vault paths:
#   revvel/shared/control-plane/composio
#   revvel/shared/control-plane/firecrawl
#   revvel/shared/search/tavily
#   revvel/shared/control-plane/obot
# Standard:   docs/Master_Inventory/MCP_STANDARD.md
# MCP:        mcp-servers/wr-control-plane/
# Workflow:   .github/workflows/wr-pr-creation.yml, jules-invoke.yml, openrouter-coder.yml
# ─────────────────────────────────────────────
# Composio API key — GitHub / Slack / Notion / 100+ tool router with per-user
# OAuth passthrough. Used as the future replacement for raw `gh` / github-script
# calls in the WR pipeline.
COMPOSIO_API_KEY=

# Firecrawl API key — autonomous web/PDF research engine. Complements (does not
# replace) Jules; recommended whenever WRs reference docs, PDFs, or external
# APIs the agent must read deterministically.
FIRECRAWL_API_KEY=

# Tavily API key — LLM-optimized live web search and content extraction. Use
# alongside Firecrawl: Tavily for fast topical search and LLM-tuned snippet
# retrieval, Firecrawl for deterministic crawl / scrape / PDF extraction. Both
# are detected as candidates by the WR / PR control-plane MCP whenever a WR
# carries URLs or research signals.
# Vault path: revvel/shared/search/tavily
TAVILY_API_KEY=

# Obot governance plane base URL — required to enable RBAC, DLP, and
# tool-definition drift detection in front of MCP traffic. Self-host via
# Docker / Kubernetes per docs/Master_Inventory/MCP_STANDARD.md.
OBOT_BASE_URL=

# Obot IdP config — JSON or path/identifier for the Identity Provider that
# brokers per-user OAuth (Okta / Entra / Authentik / Keycloak). Required for
# the per-human audit trail described in the 2026 WR-PR blueprint.
OBOT_IDP_CONFIG=

# CrewAI API key — multi-agent orchestration
# Vault path: revvel/shared/ai/crewai
CREWAI_API_KEY=

# Comma-separated allow-list of outbound hosts the Obot gateway will permit
# from MCP tool calls. Restrictive by default to mitigate the Lethal Trifecta.
OBOT_ALLOWED_HOSTS=api.github.com,github.com,openrouter.ai,api.anthropic.com,api.firecrawl.dev,api.tavily.com

# Default WR repository the WR / PR control-plane MCP server reads from when
# no repo override is supplied.
WR_DEFAULT_REPO=midnghtsapphire/revvel-standards

# ─────────────────────────────────────────────
# XAI / GROK
# Vault path: revvel/shared/ai/xai
# ─────────────────────────────────────────────
# xAI / Grok API keys for the MOTU BNAT Controller / Visiting Controller
XAI_API_KEY=
GROK_API_KEY=

# ─────────────────────────────────────────────
# CREDENTIAL BACKUP HARNESS — Doppler-independent secret recovery
# Doc: docs/CREDENTIAL_BACKUP_HARNESS.md
# Script: scripts/credential-backup-harness.js
# ─────────────────────────────────────────────
# Optional JSON object used only in trusted local/CI contexts.
CREDENTIAL_BACKUP_JSON=
# Optional local JSON/dotenv path. Keep real files out of git.
CREDENTIAL_BACKUP_JSON_FILE=
# Optional SOPS-encrypted JSON/dotenv path.
CREDENTIAL_BACKUP_SOPS_FILE=
# Optional pass path prefix, e.g. revvel.
CREDENTIAL_BACKUP_PASS_PREFIX=
# Optional Bitwarden item prefix. Requires BW_SESSION at runtime.
CREDENTIAL_BACKUP_BW_PREFIX=
BW_SESSION=
# Optional 1Password op:// template, e.g. op://Revvel/{secret}/credential.
CREDENTIAL_BACKUP_1PASSWORD_TEMPLATE=
OP_SERVICE_ACCOUNT_TOKEN=
# Optional FOSS/backup vault indicators.
INFISICAL_TOKEN=
VAULT_ADDR=

# ─────────────────────────────────────────────
# PR → SLACK CARDS — MergeMe (mergeme.dev)
# Docs:       docs/MERGEME_INTEGRATION.md
# Product:    products/mergeme-status (port 3012)
# Workflow:   .github/workflows/mergeme-status.yml
# Auditor:    scripts/mergeme-wiring.js
# ─────────────────────────────────────────────
# No MERGEME_API_KEY is required in this repository. MergeMe authenticates via
# GitHub App install + Slack OAuth at https://mergeme.dev (marketplace:
# https://github.com/marketplace/mergeme-app). Owner maps
# midnghtsapphire/revvel-standards → a Slack channel in the MergeMe dashboard.
# Optional local override for the status UI only (public repo slug):
# NEXT_PUBLIC_GITHUB_REPO=midnghtsapphire/revvel-standards

# ─────────────────────────────────────────────
# AI CODE REVIEW — BITO AI (Persistent-Memory Code Reviewer)
# Vault path: revvel/shared/code-review/bito
# Skill:      skills/bito-ai/SKILL.md
# Standard:   standards/BITO_AI_INTEGRATION_STANDARD.md
# Workflow:   .github/workflows/bito-ai.yml
# ─────────────────────────────────────────────
# BITO AI API key — used by bito-ai.yml to run persistent-memory code review
# on every PR. Also used by the BITO CLI for local review and desktop API
# procurement. Obtain at: https://bito.ai → Settings → API Keys.
# NEVER expose this in client code or commit a real value.
BITO_API_KEY=

# ─────────────────────────────────────────────
# AI MARKETING — NoimosAI (Autonomous Marketing Team)
# Vault path: revvel/shared/marketing/noimosai
# Skill:      skills/noimosai/SKILL.md
# Standard:   standards/NOIMOSAI_INTEGRATION_STANDARD.md
# Workflow:   .github/workflows/noimosai.yml
# ─────────────────────────────────────────────
# NoimosAI API key — used by noimosai.yml to trigger autonomous marketing
# tasks (SEO, content, social, affiliate) for any project in the org.
# Obtain at: https://noimosai.com → Settings → API Keys.
# NEVER expose this in client code or commit a real value.
NOIMOSAI_API_KEY=
# Optional: NoimosAI workspace/team identifier (required for multi-team setups).
NOIMOSAI_WORKSPACE_ID=

# ─────────────────────────────────────────────
# SEARCH — MeiliSearch (product/catalog search)
# Vault path: revvel/shared/search/meilisearch
# POC:        poc/meilisearch/
# Guide:      docs/MEILISEARCH_INTEGRATION_GUIDE.md
# MCP:        mcp-servers/meilisearch-mcp/
# ─────────────────────────────────────────────
# MeiliSearch instance URL. For local Docker POC: http://localhost:7700
# For MeiliSearch Cloud: https://<project>.meilisearch.io
MEILI_HOST=
# Master key (self-hosted) or API key (MeiliSearch Cloud).
# Leave empty to use the Docker default ("masterKey") for local dev.
# NEVER commit a real key — store in Vault at revvel/shared/search/meilisearch.
MEILI_KEY=

# ─────────────────────────────────────────────
# SEARCH — Brave Search API
# Vault path: revvel/shared/search/brave
# ─────────────────────────────────────────────
BRAVE_SEARCH_API_KEY=

# TAVILY_API_KEY is defined once in the WR / PR CONTROL PLANE section above
# (search for "Tavily API key"). Do not redeclare it here — duplicate keys
# silently shadow the documented declaration depending on the parser.

# ─────────────────────────────────────────────
# MAPS
# Vault path: revvel/shared/maps/google
# ─────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─────────────────────────────────────────────
# NOTIFICATIONS
# Vault path: revvel/shared/notifications/firebase
# ─────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT=

# ─────────────────────────────────────────────
# EMAIL
# Vault path: revvel/shared/email/resend
# ─────────────────────────────────────────────
RESEND_API_KEY=

# ─────────────────────────────────────────────
# ANALYTICS — Mixpanel
# Vault path: revvel/apps/<app>/<env>/mixpanel
# Skill:      skills/mixpanel/SKILL.md
# Standard:   docs/MIXPANEL_INTEGRATION.md
# ─────────────────────────────────────────────
# Project token — safe to expose in client bundles.
# Mixpanel Dashboard → Project Settings → Access Keys → Project Token.
MIXPANEL_TOKEN=
# Same token, exposed to the browser bundle in Next.js apps.
NEXT_PUBLIC_MIXPANEL_TOKEN=
# API secret — SERVER ONLY. Used for data-export and engage APIs.
# NEVER reference this in client code or commit a real value.
MIXPANEL_API_SECRET=
# Override for EU residency projects. Default is https://api.mixpanel.com.
# Set to https://api-eu.mixpanel.com for EU traffic.
MIXPANEL_API_HOST=

# ─────────────────────────────────────────────
# ANALYTICS — Amplitude (events INTO Amplitude)
# Vault path: revvel/shared/analytics/amplitude
# Standard:   standards/AMPLITUDE_INTEGRATION_STANDARD.md
# Workflow:   .github/workflows/amplitude-events.yml
# ─────────────────────────────────────────────
# Amplitude project API key. Settings → Projects → API Key.
AMPLITUDE_API_KEY=
# Amplitude project SECRET key. Required by the Dashboard REST API
# (HTTP Basic auth: api_key:secret_key). Server-only — never expose in
# client bundles. Used by the Amplitude → Notion agent (see below).
AMPLITUDE_SECRET_KEY=

# ─────────────────────────────────────────────
# AGENT — Amplitude → Notion (read side: Amplitude data INTO Notion)
# Vault paths: revvel/shared/analytics/amplitude
#              revvel/shared/notion/standards
# Skill:       skills/amplitude-notion-agent/SKILL.md
# Standard:    standards/AMPLITUDE_NOTION_AGENT_STANDARD.md
# Workflow:    .github/workflows/amplitude-to-notion.yml
# ─────────────────────────────────────────────
# Notion internal-integration token (secret_...). Create at:
# https://www.notion.so/my-integrations
NOTION_API_KEY=
# Target Notion database ID for Amplitude snapshots. The integration tied
# to NOTION_API_KEY MUST be shared with this database in Notion
# (database header → ▼ → Add connections).
NOTION_AMPLITUDE_DATABASE_ID=
# Saved Amplitude chart ID to query (from the chart URL: /chart/<id>).
# Set as a repo VARIABLE (not a secret) in CI, but documented here for
# local dry runs of scripts/amplitude-to-notion.js.
AMPLITUDE_CHART_ID=
# Optional: "us" (default) or "eu" — Amplitude data residency.
AMPLITUDE_REGION=
# Optional: Notion API version header. Default: 2022-06-28
NOTION_VERSION=

# ─────────────────────────────────────────────
# DEPLOYMENT — DigitalOcean
# Vault path: revvel/shared/deploy/digitalocean
# ─────────────────────────────────────────────
# Personal access token with Read+Write scopes.
# Used by deploy-oaudrey.yml via doctl.
# Create at: https://cloud.digitalocean.com/account/api/tokens
DIGITALOCEAN_API_TOKEN=

# ─────────────────────────────────────────────
# DNS — Namecheap
# Vault path: revvel/shared/dns/namecheap
# ─────────────────────────────────────────────
# Enable at: Namecheap Profile → API Access → Enable API
# Whitelist your server's IP in the API access panel.
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=uprisinghope

# ─────────────────────────────────────────────
# VAULT (CI/CD — used by vault-provisioning.yml)
# ─────────────────────────────────────────────
VAULT_ADDR=
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# ─────────────────────────────────────────────
# BILLING — RevenueCat (subscriptions / IAP / paywalls)
# Vault path: revvel/shared/billing/revenuecat
#         or  revvel/apps/<app>/<env>/billing/revenuecat (app-scoped)
# Standard:   standards/REVENUECAT.md
# ─────────────────────────────────────────────
# Public SDK keys — safe to embed in client bundles. One per platform.
REVENUECAT_PUBLIC_API_KEY_IOS=
REVENUECAT_PUBLIC_API_KEY_ANDROID=
REVENUECAT_PUBLIC_API_KEY_AMAZON=
REVENUECAT_PUBLIC_API_KEY_WEB=
# Server-side REST key — backend only, NEVER ship to clients.
REVENUECAT_SECRET_API_KEY=
# Shared secret used to verify the Authorization header on inbound webhooks.
REVENUECAT_WEBHOOK_AUTHORIZATION=
# RevenueCat project identifier (required for v2 REST API calls).
REVENUECAT_PROJECT_ID=

# Neon serverless Postgres (API + Actions preview branches + control console)
NEON_API_KEY=
# Optional default project id (also used as GitHub Actions repository variable)
NEON_PROJECT_ID=
