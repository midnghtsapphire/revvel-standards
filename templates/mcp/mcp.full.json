{
  "_comment": "Revvel Full MCP Config — All 32 standard servers. Copy to .mcp.json at your project root. Fill in ${ENV_VAR} values in .env (never in this file).",
  "mcpServers": {

    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "${DATABASE_URL}"]
    },

    "sqlite": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sqlite", "--db-path", "${SQLITE_DB_PATH}"]
    },

    "mongodb": {
      "command": "npx",
      "args": ["-y", "mcp-mongo-server", "${MONGODB_URI}"]
    },

    "clickhouse": {
      "command": "uvx",
      "args": ["mcp-clickhouse"],
      "env": {
        "CLICKHOUSE_HOST": "${CLICKHOUSE_HOST}",
        "CLICKHOUSE_PORT": "${CLICKHOUSE_PORT}",
        "CLICKHOUSE_USER": "${CLICKHOUSE_USER}",
        "CLICKHOUSE_PASSWORD": "${CLICKHOUSE_PASSWORD}",
        "CLICKHOUSE_DATABASE": "${CLICKHOUSE_DATABASE}"
      }
    },

    "duckduckgo": {
      "command": "npx",
      "args": ["-y", "duckduckgo-mcp-server"]
    },

    "tavily": {
      "command": "npx",
      "args": ["-y", "@tavily/mcp"],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },

    "google-news": {
      "command": "npx",
      "args": ["-y", "server-google-news"]
    },

    "brave-search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    },

    "meilisearch": {
      "command": "python",
      "args": ["-m", "meilisearch_mcp.server"],
      "env": {
        "MEILI_HOST": "${MEILI_HOST}",
        "MEILI_KEY": "${MEILI_KEY}"
      }
    },

    "investor-agent": {
      "command": "uvx",
      "args": ["investor-agent"]
    },

    "coincap": {
      "command": "npx",
      "args": ["-y", "coincap-mcp"]
    },

    "coinmarketcap": {
      "command": "npx",
      "args": ["-y", "coinmarket-mcp-server"],
      "env": {
        "COINMARKETCAP_API_KEY": "${COINMARKETCAP_API_KEY}"
      }
    },

    "alpha-vantage": {
      "command": "npx",
      "args": ["-y", "alpha-vantage-mcp"],
      "env": {
        "ALPHA_VANTAGE_API_KEY": "${ALPHA_VANTAGE_API_KEY}"
      }
    },

    "slack": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-slack"],
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${SLACK_TEAM_ID}"
      }
    },

    "telegram": {
      "command": "telegram-mcp",
      "env": {
        "TELEGRAM_API_ID": "${TELEGRAM_API_ID}",
        "TELEGRAM_API_HASH": "${TELEGRAM_API_HASH}",
        "TELEGRAM_PHONE": "${TELEGRAM_PHONE}"
      }
    },

    "gsuite": {
      "command": "uvx",
      "args": ["mcp-gsuite"],
      "env": {
        "GSUITE_CLIENT_ID": "${GSUITE_CLIENT_ID}",
        "GSUITE_CLIENT_SECRET": "${GSUITE_CLIENT_SECRET}",
        "GSUITE_REFRESH_TOKEN": "${GSUITE_REFRESH_TOKEN}"
      }
    },

    "whatsapp": {
      "command": "whatsapp-mcp",
      "env": {
        "WHATSAPP_DB_PATH": "${WHATSAPP_DB_PATH}"
      }
    },

    "memorymesh": {
      "command": "npx",
      "args": ["-y", "memorymesh"]
    },

    "graphlit": {
      "command": "npx",
      "args": ["-y", "graphlit-mcp-server"],
      "env": {
        "GRAPHLIT_ORGANIZATION_ID": "${GRAPHLIT_ORGANIZATION_ID}",
        "GRAPHLIT_ENVIRONMENT_ID": "${GRAPHLIT_ENVIRONMENT_ID}",
        "GRAPHLIT_JWT_SECRET": "${GRAPHLIT_JWT_SECRET}"
      }
    },

    "mem0": {
      "command": "npx",
      "args": ["-y", "mem0-mcp"],
      "env": {
        "MEM0_API_KEY": "${MEM0_API_KEY}"
      }
    },

    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },

    "obsidian": {
      "command": "npx",
      "args": ["-y", "mcp-obsidian"],
      "env": {
        "OBSIDIAN_API_KEY": "${OBSIDIAN_API_KEY}",
        "OBSIDIAN_HOST": "${OBSIDIAN_HOST}"
      }
    },

    "notion": {
      "command": "npx",
      "args": ["-y", "notion-mcp-server"],
      "env": {
        "NOTION_API_KEY": "${NOTION_API_KEY}"
      }
    },

    "calculator": {
      "command": "npx",
      "args": ["-y", "mcp-server-calculator"]
    },

    "inbox-zero": {
      "command": "npx",
      "args": ["-y", "@inbox-zero/mcp"],
      "env": {
        "INBOX_ZERO_API_KEY": "${INBOX_ZERO_API_KEY}"
      }
    },

    "adobe-express": {
      "command": "npx",
      "args": ["-y", "@adobe/express-developer-mcp"]
    },

    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${PROJECT_ROOT}"]
    },

    "gdrive": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-gdrive"],
      "env": {
        "GDRIVE_CLIENT_ID": "${GDRIVE_CLIENT_ID}",
        "GDRIVE_CLIENT_SECRET": "${GDRIVE_CLIENT_SECRET}",
        "GDRIVE_REFRESH_TOKEN": "${GDRIVE_REFRESH_TOKEN}"
      }
    },

    "file-merger": {
      "command": "npx",
      "args": ["-y", "mcp-file-merger"]
    },

    "filesystem-go": {
      "command": "mcp-filesystem-server",
      "args": ["${PROJECT_ROOT}"]
    },

    "python": {
      "command": "uvx",
      "args": ["mcp-run-python"]
    },

    "javascript": {
      "command": "npx",
      "args": ["-y", "@yepcode/mcp-server-js"],
      "env": {
        "YEPCODE_API_TOKEN": "${YEPCODE_API_TOKEN}"
      }
    },

    "desktop-commander": {
      "command": "npx",
      "args": ["-y", "@wonderwhy-er/desktop-commander"]
    },

    "serena": {
      "command": "uvx",
      "args": ["serena", "--context", "ide-assistant", "--project", "${PROJECT_ROOT}"]
    },

    "rvvel-affiliate-links": {
      "command": "npx",
      "args": ["rvvel-affiliate-links-mcp"]
    },

    "code-review": {
      "command": "node",
      "args": ["${CODE_REVIEW_MCP_PATH}/dist/index.js"]
    }

  }
}
