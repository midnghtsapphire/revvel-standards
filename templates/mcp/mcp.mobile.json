{
  "_comment": "Revvel Mobile MCP Config — 14 servers for Expo/React Native mobile applications. Copy to .mcp.json at project root.",
  "mcpServers": {

    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "${DATABASE_URL}"]
    },

    "sqlite": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sqlite", "--db-path", "${SQLITE_DB_PATH}"]
    },

    "duckduckgo": {
      "command": "npx",
      "args": ["-y", "duckduckgo-mcp-server"]
    },

    "tavily": {
      "command": "npx",
      "args": ["-y", "@tavily/mcp"],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },

    "meilisearch": {
      "command": "python",
      "args": ["-m", "meilisearch_mcp.server"],
      "env": {
        "MEILI_HOST": "${MEILI_HOST}",
        "MEILI_KEY": "${MEILI_KEY}"
      }
    },

    "slack": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-slack"],
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${SLACK_TEAM_ID}"
      }
    },

    "telegram": {
      "command": "telegram-mcp",
      "env": {
        "TELEGRAM_API_ID": "${TELEGRAM_API_ID}",
        "TELEGRAM_API_HASH": "${TELEGRAM_API_HASH}",
        "TELEGRAM_PHONE": "${TELEGRAM_PHONE}"
      }
    },

    "whatsapp": {
      "command": "whatsapp-mcp",
      "env": {
        "WHATSAPP_DB_PATH": "${WHATSAPP_DB_PATH}"
      }
    },

    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },

    "memorymesh": {
      "command": "npx",
      "args": ["-y", "memorymesh"]
    },

    "notion": {
      "command": "npx",
      "args": ["-y", "notion-mcp-server"],
      "env": {
        "NOTION_API_KEY": "${NOTION_API_KEY}"
      }
    },

    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${PROJECT_ROOT}"]
    },

    "python": {
      "command": "uvx",
      "args": ["mcp-run-python"]
    },

    "calculator": {
      "command": "npx",
      "args": ["-y", "mcp-server-calculator"]
    },

    "adobe-express": {
      "command": "npx",
      "args": ["-y", "@adobe/express-developer-mcp"]
    },

    "desktop-commander": {
      "command": "npx",
      "args": ["-y", "@wonderwhy-er/desktop-commander"]
    }

  }
}
