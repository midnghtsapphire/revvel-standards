# MCP Server Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — only this .env.mcp.example file is committed.
# See MCP_STANDARD.md for full documentation on each variable.

# ─────────────────────────────────────────────
# DATABASE SERVERS
# ─────────────────────────────────────────────

# Postgres MCP Server
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# SQLite MCP Server
SQLITE_DB_PATH=/absolute/path/to/database.db

# MongoDB MCP Server
MONGODB_URI=mongodb://user:password@localhost:27017/dbname

# ClickHouse MCP Server
CLICKHOUSE_HOST=your-clickhouse-host.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-clickhouse-password
CLICKHOUSE_DATABASE=default

# ─────────────────────────────────────────────
# SEARCH SERVERS
# ─────────────────────────────────────────────

# DuckDuckGo MCP Server — no API key required

# Brave Search MCP Server
# Get free key: https://brave.com/search/api/
BRAVE_API_KEY=BSAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tavily MCP
# Get free key: https://tavily.com/
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google News MCP Server — no API key required

# ─────────────────────────────────────────────
# FINANCE SERVERS
# ─────────────────────────────────────────────

# Investor Agent — no API key required (uses public data sources)

# Coincap MCP Server — no API key required

# CoinMarketCap MCP Server
# Get free key: https://coinmarketcap.com/api/
COINMARKETCAP_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Alpha Vantage MCP Server
# Get free key (25 req/day): https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=XXXXXXXXXXXXXXXX

# ─────────────────────────────────────────────
# COMMUNICATION SERVERS
# ─────────────────────────────────────────────

# Slack MCP Server
# Create a Slack App: https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_TEAM_ID=TXXXXXXXXXX

# Telegram MCP Server
# Get credentials: https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_PHONE=+12125551234

# Google GSuite MCP Server
# Set up OAuth: https://console.cloud.google.com/
GSUITE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GSUITE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GSUITE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WhatsApp MCP Server
# Path to your WhatsApp database file (macOS default location shown)
WHATSAPP_DB_PATH=/Users/yourname/Library/Group Containers/group.net.whatsapp.WhatsApp.shared/ChatStorage.sqlite

# ─────────────────────────────────────────────
# KNOWLEDGE & MEMORY SERVERS
# ─────────────────────────────────────────────

# MemoryMesh — no credentials required

# Graphlit MCP Server
# Get credentials: https://www.graphlit.com/
GRAPHLIT_ORGANIZATION_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GRAPHLIT_ENVIRONMENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GRAPHLIT_JWT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mem0 MCP Server
# Get key: https://app.mem0.ai/
MEM0_API_KEY=m0-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Memory MCP Server — no credentials required

# ─────────────────────────────────────────────
# PRODUCTIVITY SERVERS
# ─────────────────────────────────────────────

# Obsidian MCP Server
# Requires "Local REST API" plugin installed in Obsidian
# Plugin: https://github.com/coddingtonbear/obsidian-local-rest-api
OBSIDIAN_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OBSIDIAN_HOST=http://localhost:27123

# Notion MCP Server
# Get integration token: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MCP Calculator Server — no credentials required

# Inbox Zero MCP Server
# Get key: https://app.getinboxzero.com/settings
INBOX_ZERO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────
# FILESYSTEM & CLOUD STORAGE SERVERS
# ─────────────────────────────────────────────

# Filesystem MCP Server — set this to your project root
PROJECT_ROOT=/absolute/path/to/your/project

# Google Drive MCP Server
# Set up OAuth: https://console.cloud.google.com/
GDRIVE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GDRIVE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GDRIVE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MCP File Merger — no credentials required
# Filesystem Go MCP Server — no credentials required (uses PROJECT_ROOT)

# ─────────────────────────────────────────────
# CODING SERVERS
# ─────────────────────────────────────────────

# Python MCP Server (mcp-run-python) — no credentials required

# JavaScript MCP Server
# Get token: https://app.yepcode.io/settings/tokens
YEPCODE_API_TOKEN=yc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Desktop Commander MCP — no credentials required
# Serena MCP Server — no credentials required (uses PROJECT_ROOT)

# ─────────────────────────────────────────────
# CREATIVE & DESIGN SERVERS
# ─────────────────────────────────────────────

# Adobe Express Developer MCP Server — no credentials required
# Provides SDK documentation and code examples for Adobe Express Add-on development

# ─────────────────────────────────────────────
# REVVEL CUSTOM MCP SERVERS
# ─────────────────────────────────────────────

# rvvel-affiliate-links-mcp — no credentials required (self-contained SQLite)

# code-review-mcp-server — set to your local clone path
# Clone: git clone https://github.com/midnghtsapphire/code-review-mcp-server ~/mct/code-review
# Build: cd ~/mct/code-review && npm install && npm run build
CODE_REVIEW_MCP_PATH=/absolute/path/to/code-review-mcp-server

# MCT Microservice Module paths — set to local clone of each repo you use
# Clone + build: git clone https://github.com/midnghtsapphire/MCP-ANALYTICS ~/mct/analytics && cd ~/mct/analytics && npm install && npm run build
MCT_ANALYTICS_PATH=/absolute/path/to/MCP-ANALYTICS
MCT_SUBSCRIPTION_PATH=/absolute/path/to/MCP-SUBSCRIPTION
MCT_AUTH_PATH=/absolute/path/to/MCP-AUTH
MCT_PAYMENT_PATH=/absolute/path/to/MCP-PAYMENT
MCT_AFFILIATE_PATH=/absolute/path/to/MCP-AFFILIATE
MCT_BRANDING_PATH=/absolute/path/to/MCP-BRANDING
MCT_SEO_ACCESSIBILITY_PATH=/absolute/path/to/MCP-SEO-ACCESSIBILITY
MCT_EMAIL_MARKETING_PATH=/absolute/path/to/MCP-EMAIL-MARKETING
MCT_AD_CAMPAIGN_PATH=/absolute/path/to/MCP-AD-CAMPAIGN
MCT_CONTENT_CALENDAR_PATH=/absolute/path/to/MCP-CONTENT-CALENDAR
MCT_ADMIN_DASHBOARD_PATH=/absolute/path/to/MCP-ADMIN-DASHBOARD
MCT_AB_TESTING_PATH=/absolute/path/to/MCP-AB-TESTING
MCT_CODE_REVIEW_PATH=/absolute/path/to/MCP-CODE-REVIEW
MCT_AI_CHAT_PATH=/absolute/path/to/MCP-AI-CHAT
MCT_WEBSITE_GENERATOR_PATH=/absolute/path/to/MCP-WEBSITE-GENERATOR
MCT_CUSTOMER_SUPPORT_PATH=/absolute/path/to/MCP-CUSTOMER-SUPPORT
MCT_USER_DASHBOARD_PATH=/absolute/path/to/MCP-USER-DASHBOARD
MCT_DATA_MANAGEMENT_PATH=/absolute/path/to/MCP-DATA-MANAGEMENT

# MCT modules — not yet audited (REPORTS, KUBERNETES, LOCALIZATION, SOFTWARE-DISCOVERY)
# Clone + build each when needed: git clone https://github.com/midnghtsapphire/MCP-<NAME> ~/mct/<name>
MCT_REPORTS_PATH=/absolute/path/to/MCP-REPORTS
MCT_KUBERNETES_PATH=/absolute/path/to/MCP-KUBERNETES
MCT_LOCALIZATION_PATH=/absolute/path/to/MCP-LOCALIZATION
MCT_DISCOVERY_PATH=/absolute/path/to/MCP-SOFTWARE-DISCOVERY
