# Fastlane Appfile — App Identifiers
# Replace all [PLACEHOLDER] values with real values when accounts are ready.
# See templates/mobile/MOBILE_DEPLOYMENT.md for instructions.

# iOS App Identifier (Bundle ID)
# Format: com.revvel.[app-name] or com.[your-domain].[app-name]
app_identifier("[PLACEHOLDER]")  # e.g., "com.revvel.growlingeyes"

# Apple ID (your Apple Developer account email)
apple_id("[PLACEHOLDER]")  # e.g., "developer@yourdomain.com"

# Apple Developer Team ID
# Find at: https://developer.apple.com/account → Membership → Team ID
team_id("[PLACEHOLDER]")  # e.g., "XXXXXXXXXX"

# App Store Connect Team ID (may differ from Developer Team ID)
# itc_team_id("[PLACEHOLDER]")

# Android Package Name (must match Play Console)
# Format: com.revvel.[app-name]
