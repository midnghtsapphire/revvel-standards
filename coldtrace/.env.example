# ColdTrace — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Set to false when real API keys are configured.
DEMO_MODE=true

# ── OpenTopography (free research tier) ───────────────────────────────────────
# Register at https://opentopography.org to get a free API key.
# 2,500 requests/day on free tier.
OPENTOPOGRAPHY_API_KEY=

# ── Sentinel Hub (free research tier) ────────────────────────────────────────
# Register at https://www.sentinel-hub.com
# 30,000 processing units/month on free tier.
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL with PostGIS extension
DATABASE_URL=postgresql://coldtrace:coldtrace@localhost:5432/coldtrace

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,https://coldtrace.oaudrey.com
