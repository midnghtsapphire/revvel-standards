{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/midnghtsapphire/revvel-standards/main/schemas/prompt-knowledge-catalog.schema.json",
  "title": "Prompt Knowledge Catalog",
  "description": "Root catalog for the prompts/ knowledge repository (internal system prompts, external indexes, concepts, LLM combos, metadata, NotebookLM packs).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "updated_at",
    "roots",
    "entries",
    "concepts",
    "llm_combos",
    "notebooklm"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "censor": {
          "type": "boolean",
          "const": false,
          "description": "Catalog must not filter or censor inventory entries."
        },
        "external_bodies": {
          "type": "string",
          "enum": ["by-url", "cached-local", "embedded"]
        },
        "github_requests_scope": {
          "type": "string"
        }
      }
    },
    "roots": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "llm_combos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/llm_combo"
      }
    },
    "notebooklm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack_dir", "sources_manifest"],
      "properties": {
        "pack_dir": { "type": "string" },
        "sources_manifest": { "type": "string" },
        "export_dir": { "type": "string" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": [
            "system-prompt",
            "process",
            "external-index",
            "resource",
            "concept",
            "llm-combo",
            "folder",
            "github-request-template"
          ]
        },
        "path": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scope": {
          "type": "string",
          "enum": ["internal", "external", "shared"]
        },
        "source_url": { "type": "string" },
        "description": { "type": "string" },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "summary", "path"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "summary": { "type": "string" },
        "path": { "type": "string" },
        "related_entries": {
          "type": "array",
          "items": { "type": "string" }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "llm_combo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "models", "path"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "path": { "type": "string" },
        "use_when": { "type": "string" },
        "system_prompt_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
