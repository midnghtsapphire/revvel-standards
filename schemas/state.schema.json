{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revvel.dev/schemas/state.schema.json",
  "title": "Revvel Execution State",
  "type": "object",
  "required": ["intake_id", "product_slug", "revenue_target_monthly_usd", "goal_phase", "steps", "status"],
  "properties": {
    "intake_id": { "type": "string", "minLength": 1 },
    "product_slug": { "type": "string", "minLength": 1 },
    "created_at": { "type": ["string", "null"], "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "revenue_target_monthly_usd": { "type": "number", "minimum": 0 },
    "goal_phase": { "type": "integer", "enum": [1, 2, 3, 4] },
    "owner": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["new", "routed", "in_progress", "needs_procurement", "blocked", "done", "failed"]
    },
    "current_engine": { "type": ["string", "null"] },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step_id", "engine", "status"],
        "properties": {
          "step_id": { "type": "string", "minLength": 1 },
          "engine": { "type": "string" },
          "runner_target": {
            "type": ["string", "null"],
            "enum": [null, "github", "vercel", "supabase", "zapier", "make", "n8n", "gumloop", "cli", "browser", "polar"]
          },
          "status": {
            "type": "string",
            "enum": ["pending", "running", "ok", "needs_procurement", "failed", "skipped"]
          },
          "started_at": { "type": ["string", "null"], "format": "date-time" },
          "finished_at": { "type": ["string", "null"], "format": "date-time" },
          "artifacts": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          },
          "bom_ref": { "type": ["string", "null"] },
          "error": { "type": ["string", "null"] }
        }
      }
    },
    "bom": {
      "type": ["object", "null"],
      "required": ["items"],
      "properties": {
        "path": { "type": "string" },
        "total_usd": { "type": "number" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "acquisition"],
            "properties": {
              "name": { "type": "string" },
              "category": { "type": "string", "enum": ["credential", "api", "account", "infra", "data", "service", "human"] },
              "cost_usd": { "type": "number", "minimum": 0 },
              "source": { "type": "string" },
              "acquisition": { "type": "string" },
              "blocking": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
