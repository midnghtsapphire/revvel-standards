{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "incremental": true,
  "typescript": {
    "lineWidth": 100,
    "indentWidth": 2,
    "useTabs": false,
    "semiColons": "always",
    "quoteStyle": "preferSingle",
    "trailingCommas": "onlyMultiLine"
  },
  "json": {
    "lineWidth": 100,
    "indentWidth": 2,
    "useTabs": false,
    "trailingCommas": "never"
  },
  "markdown": {
    "lineWidth": 100,
    "textWrap": "maintain"
  },
  "includes": [
    "/dprint.json",
    "/package.json",
    "/docs/DPRINT.md",
    "/tests/dprint-check.test.js",
    "/config/**/*.{json,jsonc}"
  ],
  "excludes": [
    "**/node_modules",
    "**/*-lock.json",
    "**/dist",
    "**/coverage",
    "**/.next",
    "**/vendor",
    "wr/**",
    "docs/agents/**",
    "products/**/node_modules/**"
  ],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.96.1.wasm",
    "https://plugins.dprint.dev/json-0.23.0.wasm",
    "https://plugins.dprint.dev/markdown-0.22.1.wasm"
  ]
}
