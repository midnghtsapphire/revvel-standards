node_modules/
.next/
out/
.gitbutler/*
!.gitbutler/config.json

# Logs (but keep audit logs)
logs/*
!logs/agent-audit/
logs/agent-audit/*.log
*.log

# Python artifacts (applies repo-wide; sub-projects have their own ignores too)
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo

# Secrets / env
.env
.env.local

# Scratch files occasionally committed by automation (Jules, Copilot, etc.)
pr-body.md
.jules/
*.egg-info/
products/creator-payout-tracker/package-lock.json
products/creator-payout-tracker/.next/
products/creator-payout-tracker/node_modules/

# Vercel static build output (generated by scripts/build-static.sh)
/public/
/.claude/  # broad ignore; overridden below for .claude/hooks/ + .claude/settings.json

# agent-scorecard runtime artifact (regenerated each remediation)
wr/memory/last-remediation-plan.json

# Allow the Claude Code hooks dir (the save-transcript hook is repo-wide)
!.claude/
.claude/*
!.claude/hooks/
!.claude/hooks/**
!.claude/settings.json

# Captured Claude sessions stay on local disk under
# docs/agents/claude/transcripts/ but aren't committed by default. Force-add
# (`git add -f`) any session worth preserving in the repo. Per stop-hook race
# observed on PR #14684.
docs/agents/*/transcripts/*.jsonl
docs/agents/*/transcripts/*.md

# wr-rewrite sweep pipeline artifacts (generated at repo root by wr-rewrite.yml)
lint.txt
queue.json
target-repo/
venv/
