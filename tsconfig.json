{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "//": "Typecheck-as-build. Scope starts at the clean modules and expands over time toward repo-wide checkJs (see docs/TOOLING_STANDARDIZATION_RESEARCH.md).",
  "include": [
    "scripts/openrouter-routing.js",
    "scripts/openrouter-personas.js",
    "scripts/openrouter-personas-example.js"
  ]
}
