# Kong Gateway OSS — Environment Configuration
# Copy to .env and fill in values, or use Doppler:
#   doppler run --project growlingeyes --config prd -- docker compose up -d

# PostgreSQL credentials for Kong's datastore
KONG_PG_USER=kong
KONG_PG_PASSWORD=CHANGE_ME_use_doppler_or_generate_with_openssl_rand_hex_32
KONG_PG_DATABASE=kong

# Kong proxy ports (external traffic enters here)
KONG_PROXY_PORT=8000
KONG_PROXY_SSL_PORT=8443

# Upstream service URLs (where Kong forwards traffic)
# These are the actual backend services running on the host
GROWLINGEYES_URL=http://host.docker.internal:3000
NEUROOZ_URL=http://host.docker.internal:5173
REESE_REVIEWS_URL=http://host.docker.internal:8080

# Doppler token (for agents to manage secrets)
# DOPPLER_TOKEN=dp.sa.xxx  # Set via Devin secrets, not here
