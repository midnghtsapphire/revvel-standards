# ReeseReviews Environment Configuration

# ============================================
# API Keys (Automated Setup Available)
# ============================================

# Review Collection APIs
JUDGEME_API_KEY=
AMAZON_PA_API_KEY=
AMAZON_PA_API_SECRET=
GOOGLE_MY_BUSINESS_API_KEY=

# Social Media Management
TRIGIFY_API_KEY=
N8N_WEBHOOK_URL=
BUFFER_API_KEY=

# Domain Management
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=

# ============================================
# Database Configuration
# ============================================

DATABASE_URL=postgresql://user:password@localhost:5432/reesereviews
REDIS_URL=redis://localhost:6379

# ============================================
# Application Settings
# ============================================

NODE_ENV=development
PORT=8080
API_BASE_URL=https://reesereviews.com/api
FRONTEND_URL=https://reesereviews.com

# ============================================
# Feature Flags
# ============================================

USE_MOCK_APIS=true
ENABLE_SCRAPING=false
ENABLE_AUTO_POSTING=false
ENABLE_ANALYTICS=true

# ============================================
# OpenRouter (for AI features)
# ============================================

OPENROUTER_API_KEY=

# ============================================
# Email & Notifications
# ============================================

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@reesereviews.com

# ============================================
# Odoo CRM Integration
# ============================================

ODOO_URL=https://odoo.revvel.io
ODOO_DB=production
ODOO_USERNAME=
ODOO_PASSWORD=

# ============================================
# Gusto Integration
# ============================================

GUSTO_API_KEY=
GUSTO_COMPANY_ID=

# ============================================
# Analytics
# ============================================

GOOGLE_ANALYTICS_ID=
AMPLITUDE_API_KEY=

# ============================================
# Security
# ============================================

JWT_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=

# ============================================
# Rate Limiting
# ============================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Caching
# ============================================

CACHE_TTL_SECONDS=3600
ENABLE_CACHE=true

# ============================================
# Logging
# ============================================

LOG_LEVEL=info
LOG_FILE=logs/reesereviews.log

# ============================================
# Testing
# ============================================

TEST_MODE=false
MOCK_REVIEWS_COUNT=50
MOCK_PRODUCTS_COUNT=100
