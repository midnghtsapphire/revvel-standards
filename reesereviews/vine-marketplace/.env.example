# Vine Marketplace — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ─────────────────────────────────────────────
# Gmail / IMAP (angelreporters@gmail.com)
# ─────────────────────────────────────────────

# Your Gmail address
GMAIL_USER=angelreporters@gmail.com

# App Password (NOT your account password)
# Generate at: https://myaccount.google.com/apppasswords
# Steps:
#   1. Google Account → Security → 2-Step Verification → ON
#   2. Google Account → Security → App passwords
#   3. App = Mail, Device = Other → name it "vine-marketplace"
#   4. Copy the 16-char password here (no spaces)
GMAIL_APP_PASSWORD=

# Optional: override IMAP server (default: imap.gmail.com:993)
# GMAIL_IMAP_HOST=imap.gmail.com
# GMAIL_IMAP_PORT=993

# ─────────────────────────────────────────────
# Meta (Facebook) Graph API
# ─────────────────────────────────────────────

# Facebook Page Access Token
# Steps to get:
#   1. Go to https://developers.facebook.com → My Apps → Create App
#   2. Add "Facebook Login" and "Pages" products
#   3. Go to Graph API Explorer → choose your Page → request these permissions:
#      pages_manage_posts, pages_read_engagement, pages_show_list
#   4. Generate a long-lived Page Access Token (never expires with offline_access)
#   See: https://developers.facebook.com/docs/pages/access-tokens
META_PAGE_ACCESS_TOKEN=

# Your Facebook Page numeric ID
# Find at: https://www.facebook.com/YOUR_PAGE → About → Page ID
META_PAGE_ID=

# (Optional) Facebook Commerce Manager Catalog ID
# Enables proper Marketplace product listings with price/condition fields.
# Find at: https://business.facebook.com/commerce → Catalog → Settings
# Leave blank to use Page Posts only (no catalog required)
META_CATALOG_ID=

# API version (do not change unless Meta deprecates it)
META_API_VERSION=v19.0

# ─────────────────────────────────────────────
# Pricing
# ─────────────────────────────────────────────

# Discount rate (0.20 = 20% off cost basis — default per owner spec)
LISTING_DISCOUNT_RATE=0.20

# Minimum listing price in USD
MIN_LISTING_PRICE=1.00

# ─────────────────────────────────────────────
# Automation
# ─────────────────────────────────────────────

# Dashboard port
PORT=3030

# Automatically post to Facebook after fetching emails (true/false)
ENABLE_AUTO_POSTING=false

# Days before a listing is considered "stale" and needs a repost
REPOST_STALE_DAYS=7

# Cron schedule for email fetch (default: 8am, 2pm, 8pm daily)
FETCH_CRON=0 8,14,20 * * *

# Cron schedule for reposting stale listings (default: Monday 10am)
REPOST_CRON=0 10 * * 1

# ─────────────────────────────────────────────
# Path A — Lifestyle marketplace packs (local)
# ─────────────────────────────────────────────

# Where packs are written (default: Documents/MarketplacePacks)
# MARKETPLACE_PACKS_DIR=C:\Users\YOU\Documents\MarketplacePacks

# Required for lifestyle / in-use image generation (not stock-only)
OPENROUTER_API_KEY=

# Optional image model on OpenRouter (must support image output)
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image-preview
