{
  "name": "Amazon Deal to Lemon8 (hourly)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Every hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "command": "cd /opt/manus/automation/amazon-lemon8 && python3 run.py --tag {{$env.AMAZON_TAG}} --max-price {{$env.MAX_PRICE}} --min-discount {{$env.MIN_DISCOUNT}} --publish --headless"
      },
      "id": "run",
      "name": "Run deal scout",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "ok",
              "leftValue": "={{$json.exitCode}}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if",
      "name": "Published?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "revenue-ops"
        },
        "text": "=Amazon\u2192Lemon8: {{$json.stdout}}"
      },
      "id": "slack_ok",
      "name": "Slack success",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        660,
        -80
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "revenue-ops"
        },
        "text": "=Amazon\u2192Lemon8 needs human (exit {{$json.exitCode}}): {{$json.stderr}}"
      },
      "id": "slack_fail",
      "name": "Slack needs-human",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        660,
        80
      ]
    }
  ],
  "connections": {
    "Every hour": {
      "main": [
        [
          {
            "node": "Run deal scout",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run deal scout": {
      "main": [
        [
          {
            "node": "Published?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Published?": {
      "main": [
        [
          {
            "node": "Slack success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Slack needs-human",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}