{
  "schema": "midnghtsapphire.automation_package/v2",
  "template_id": "image-seo-pipeline",
  "brand": "MIDNGHTSAPPHIRE",
  "human_gate": {
    "auto_merge": false
  },
  "note": "Import into Gumloop; secrets by name only.",
  "trigger": {
    "type": "webhook",
    "name": "image.seo.request"
  },
  "nodes": [
    {
      "id": "n1",
      "type": "input.brief",
      "name": "Intake"
    },
    {
      "id": "n2",
      "type": "agent.lsi",
      "name": "LSI expand"
    },
    {
      "id": "n3",
      "type": "agent.seo",
      "name": "SEO pack"
    },
    {
      "id": "n4",
      "type": "image.generate",
      "name": "Generate"
    },
    {
      "id": "n5",
      "type": "qa.image_seo",
      "name": "QA"
    },
    {
      "id": "n6",
      "type": "github.pr",
      "name": "Draft PR only",
      "config": {
        "auto_merge": false
      }
    }
  ]
}
