{
  "name": "Release Banner Social",
  "meta": {
    "templateId": "release-banner-social",
    "brand": "MIDNGHTSAPPHIRE"
  },
  "nodes": [
    { "name": "Release Trigger", "type": "n8n-nodes-base.webhook" },
    {
      "name": "Build SEO Pack",
      "type": "n8n-nodes-base.executeCommand",
      "parameters": {
        "command": "node scripts/image-seo-build-pack.mjs --brief /tmp/brief.json --out /tmp/release-pack.json"
      }
    },
    { "name": "Render Banner", "type": "n8n-nodes-base.httpRequest" },
    {
      "name": "Discord",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "note": "Use secret name DISCORD_WEBHOOK_URL only"
      }
    },
    {
      "name": "X Post",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "note": "Use TWITTER_* secret names from config/connections.image-automation.yml"
      }
    }
  ],
  "human_gate": {
    "auto_merge": false
  },
  "secrets_by_name": [
    "DISCORD_WEBHOOK_URL",
    "TWITTER_CONSUMER_API_KEY",
    "TWITTER_CONSUMER_API_SECRET",
    "TWITTER_ACCESS_TOKEN",
    "TWITTER_ACCESS_TOKEN_SECRET"
  ]
}
