{
  "name": "Revvel Standards - Defensive Validation Guardrail Alerting Engine",
  "nodes": [
    {
      "parameters": {
        "onError": "continueRegularStream"
      },
      "id": "e1a1a1a1-b2b2-3c3c-4d4d-5e5e5e5e5e5e",
      "name": "Error Trigger Node",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [380, 240]
    },
    {
      "parameters": {
        "jsCode": "const errorData = $input.all()[0]?.json || {};\n\n// Format unified markdown notification architecture strings safely\nconst formattedMessage = `🚨 **Revvel Standards: Validation Circuit Breaker Tripped** 🚨\\n\\n` +\n  `• **Pipeline Origin:** ${errorData.execution?.workflow?.name || 'Agent Factory Engine'}\\n` +\n  `• **Execution ID:** \\`${errorData.execution?.id || 'N/A'}\\`\\n` +\n  `• **Error Type:** \\`${errorData.error?.name || 'SchemaViolationException'}\\`\\n` +\n  `• **Detailed Manifest Diagnostic:** _${errorData.error?.message || 'Manifest broke skill budget ceiling rules.'}_\\n\\n` +\n  `👉 [Investigate Deployment Log Workspace](${errorData.execution?.url || 'http://localhost:5678'})`;\n\nreturn [{\n  json: {\n    alert_payload: formattedMessage,\n    timestamp: new Date().toISOString(),\n    severity: \"CRITICAL\"\n  }\n}];"
      },
      "id": "e2a2a2a2-b3b3-4c4c-5d5d-6e6e6e6e6e6e",
      "name": "Format Incident Details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 240]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-slack-check",
              "leftValue": "={{ $json.severity }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "CRITICAL"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e3a3a3a3-b4b4-5c5c-6d6d-7e7e7e7e7e7e",
      "name": "Route Alert Streams",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [820, 240]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": "={{ $env.SLACK_LOG_CHANNEL_ID || 'C0123456789' }}",
        "text": "={{ $json.alert_payload }}",
        "options": {
          "includeLinkToWorkflow": false
        }
      },
      "id": "e4a4a4a4-b5b5-6c6c-7d7d-8e8e8e8e8e8e",
      "name": "Slack Alert Hub",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [1080, 100],
      "credentials": {
        "slackApi": {
          "id": "YOUR_SLACK_CREDENTIAL_ID",
          "name": "Slack account"
        }
      }
    },
    {
      "parameters": {
        "webhookUri": "={{ $env.DISCORD_INCIDENT_WEBHOOK_URL || 'https://discord.com/api/webhooks/REPLACE_ME' }}",
        "text": "={{ $json.alert_payload }}",
        "options": {}
      },
      "id": "e5a5a5a5-b6b6-7c7c-8d8d-9e9e9e9e9e9e",
      "name": "Discord Alert Hub",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [1080, 240]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.VALIDATION_ALERT_FROM_EMAIL || 'agent-factory@yourdomain.com' }}",
        "toEmail": "={{ $env.VALIDATION_ALERT_TO_EMAIL || 'audrey@yourdomain.com' }}",
        "subject": "⚠️ Revvel Validation Failure Notification",
        "text": "={{ $json.alert_payload }}",
        "options": {}
      },
      "id": "e6a6a6a6-b7b7-8c8c-9d9d-0e0e0e0e0e0e",
      "name": "Email Provider Dispatch",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1080, 380],
      "credentials": {
        "smtp": {
          "id": "YOUR_EMAIL_PROVIDER_SMTP_CREDENTIAL_ID",
          "name": "SMTP account"
        }
      }
    }
  ],
  "connections": {
    "Error Trigger Node": {
      "main": [
        [
          {
            "node": "Format Incident Details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Incident Details": {
      "main": [
        [
          {
            "node": "Route Alert Streams",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route Alert Streams": {
      "main": [
        [
          {
            "node": "Slack Alert Hub",
            "type": "main",
            "index": 0
          },
          {
            "node": "Discord Alert Hub",
            "type": "main",
            "index": 0
          },
          {
            "node": "Email Provider Dispatch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionTimeout": 30,
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false,
    "description": "Catches agent-manifest validation failures and fans CRITICAL alerts to Slack, Discord, and email. Pair with schemas/registry_rules.json and scripts/validate-agent-manifest.js."
  },
  "tags": [
    {
      "name": "revvel-standards"
    },
    {
      "name": "validation"
    },
    {
      "name": "alerting"
    }
  ]
}
