{
  "name": "PDF Product Creation - Make.com",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": "pdf-product-webhook",
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "restore": {},
        "expect": [
          {
            "name": "niche",
            "type": "text",
            "label": "Niche",
            "required": true
          },
          {
            "name": "keywords",
            "type": "array",
            "label": "Keywords"
          }
        ]
      }
    },
    {
      "id": 2,
      "module": "util:SetVariable",
      "version": 1,
      "parameters": {},
      "mapper": {
        "name": "trend_research",
        "value": "{{1.niche}}",
        "scope": "roundtrip"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Step 1: Identify Problem"
        },
        "restore": {
          "expect": {
            "scope": {
              "label": "One cycle"
            }
          }
        }
      }
    },
    {
      "id": 3,
      "module": "anthropic:createMessage",
      "version": 1,
      "parameters": {
        "model": "claude-sonnet-4",
        "max_tokens": 2000
      },
      "mapper": {
        "messages": [
          {
            "role": "user",
            "content": "You are a product title expert. Based on the niche \"{{1.niche}}\" and search trends, create a catchy, emotional title and subtitle for a PDF guide.\n\nThe title should:\n- Be emotionally compelling\n- Address a specific pain point\n- Be under 10 words\n- Create urgency or relate to a common struggle\n\nFormat your response as JSON:\n{\n  \"title\": \"Your catchy title here\",\n  \"subtitle\": \"Your compelling subtitle that explains the solution\",\n  \"target_audience\": \"Who this is for\"\n}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "Step 2: Generate Title"
        }
      }
    },
    {
      "id": 10,
      "module": "util:SetVariable",
      "version": 1,
      "parameters": {},
      "mapper": {
        "name": "claude_clean_json",
        "value": "{{trim(replace(replace(3.content.0.text; \"```json\"; \"\"); \"```\"; \"\"))}}",
        "scope": "roundtrip"
      },
      "metadata": {
        "designer": {
          "x": 750,
          "y": 0,
          "name": "Step 2b: Strip Markdown Fences"
        },
        "restore": {
          "expect": {
            "scope": {
              "label": "One cycle"
            }
          }
        }
      }
    },
    {
      "id": 4,
      "module": "json:ParseJSON",
      "version": 1,
      "parameters": {},
      "mapper": {
        "json": "{{10.value}}"
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0,
          "name": "Parse Title JSON"
        }
      }
    },
    {
      "id": 5,
      "module": "anthropic:createMessage",
      "version": 1,
      "parameters": {
        "model": "claude-sonnet-4",
        "max_tokens": 8000
      },
      "mapper": {
        "messages": [
          {
            "role": "user",
            "content": "Create a comprehensive PDF guide with the following details:\n\nTitle: {{4.title}}\nSubtitle: {{4.subtitle}}\nTarget Audience: {{4.target_audience}}\n\nWrite a complete, actionable guide with:\n\n1. Introduction (addressing the pain point)\n2. Understanding the Problem (why this matters)\n3. The Solution Framework (3-5 main strategies)\n4. Step-by-step implementation for each strategy\n5. Common mistakes to avoid\n6. Quick wins (immediate actions readers can take)\n7. Long-term success tips\n8. Conclusion with encouragement\n\nMake it:\n- Practical and actionable\n- Empathetic and understanding\n- 15-20 pages worth of content\n- Written in a conversational, supportive tone\n- Include specific examples\n\nFormat as markdown with clear headings."
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0,
          "name": "Step 3: Generate Content"
        }
      }
    },
    {
      "id": 6,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true
      },
      "mapper": {
        "url": "https://api.canva.com/v1/designs",
        "method": "post",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{connection.canva_token}}"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "qs": [],
        "bodyType": "raw",
        "rawType": "json",
        "body": "{\n  \"design_type\": {\n    \"type\": \"preset\",\n    \"name\": \"presentation\"\n  },\n  \"title\": \"{{4.title}}\"\n}"
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 0,
          "name": "Step 4: Create Canva Design"
        }
      }
    },
    {
      "id": 7,
      "module": "shopify:createProduct",
      "version": 1,
      "parameters": {
        "shopDomain": "{{connection.shopify_domain}}"
      },
      "mapper": {
        "title": "{{4.title}}",
        "body_html": "<p>{{4.subtitle}}</p>",
        "vendor": "Freedom Angel Corp",
        "product_type": "Digital Download",
        "tags": "pdf,guide,{{1.niche}}",
        "variants": [
          {
            "price": "29.00",
            "sku": "PDF-{{now}}",
            "inventory_management": ""
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 1800,
          "y": 0,
          "name": "Step 5: Create Shopify Product"
        }
      }
    },
    {
      "id": 8,
      "module": "util:SetVariables",
      "version": 1,
      "parameters": {},
      "mapper": {
        "variables": [
          {
            "name": "campaign_niche",
            "value": "{{1.niche}}"
          },
          {
            "name": "campaign_title",
            "value": "{{4.title}}"
          },
          {
            "name": "product_url",
            "value": "{{7.admin_graphql_api_id}}"
          },
          {
            "name": "commission_high",
            "value": "50%"
          },
          {
            "name": "commission_flat",
            "value": "$700 + 15%"
          }
        ],
        "scope": "roundtrip"
      },
      "metadata": {
        "designer": {
          "x": 2100,
          "y": 0,
          "name": "Step 6: Prepare Influencer Campaign"
        }
      }
    },
    {
      "id": 9,
      "module": "gateway:WebhookRespond",
      "version": 1,
      "parameters": {},
      "mapper": {
        "status": "200",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": "{\n  \"status\": \"success\",\n  \"product_title\": \"{{4.title}}\",\n  \"product_id\": \"{{7.id}}\",\n  \"shopify_url\": \"{{7.admin_graphql_api_id}}\",\n  \"next_step\": \"influencer_outreach\",\n  \"campaign_ready\": true\n}"
      },
      "metadata": {
        "designer": {
          "x": 2400,
          "y": 0,
          "name": "Return Success"
        }
      }
    }
  ],
  "metadata": {
    "version": 1,
    "scenario": {
      "name": "PDF Product Creation Pipeline",
      "flow": true,
      "acute": false,
      "scheduling": {
        "type": "indefinitely"
      }
    },
    "designer": {
      "orphans": []
    },
    "zone": "us1.make.com"
  }
}
