# flake8 config for revvel-standards (WR #15858).
# CI entrypoint: .github/workflows/python-flake8.yml (py-actions/flake8@v2.3.0).
# Gate behavior: scripts/flake8-baseline-gate.js ratchets against config/flake8-baseline.txt
# so pre-existing debt does not red-main (GREEN_MAIN_STANDARD + WR explicit exclusion).
# New path::CODE counts above baseline fail the build.

[flake8]
# Required style families from WR #15858: pycodestyle (E/W) + pyflakes (F).
select = E,W,F
max-line-length = 120
max-complexity = 15
# Exclude only cache/vendor noise — never drop tests/, scripts/, tools/, or product code.
exclude =
    .git,
    node_modules,
    venv,
    .venv,
    __pycache__,
    dist,
    build,
    .tox,
    .mypy_cache,
    .eggs,
    *.egg-info,
    .pytest_cache
show-source = True
statistics = True
