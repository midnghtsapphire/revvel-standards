{
  // Revvel Standards markdown rules.
  //
  // The rules live in .markdownlint.yaml. This file exists only because both
  // markdownlint-cli and markdownlint-cli2 auto-discover .markdownlint.jsonc
  // from the repo root, and that discovery overrides an explicit --config —
  // so a jsonc file holding its own rules silently wins over the config the
  // workflow names. It did, for as long as this file restated them.
  //
  // Do not add keys here. tests/markdown-gates-agree.test.js fails if this
  // file grows anything other than "extends".
  "extends": ".markdownlint.yaml"
}
