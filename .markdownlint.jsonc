{
  // Revvel Standards Markdown Linter Configuration
  // See https://github.com/DavidAnson/markdownlint for rule details
  
  "default": true,
  
  // MD013: Line length - disabled for docs with long URLs and tables
  "MD013": false,
  
  // MD033: Inline HTML - allowed for badges, custom formatting
  "MD033": false,
  
  // MD041: First line in file should be a top level heading - disabled
  // because some files have front matter or comments first
  "MD041": false,
  
  // MD024: Multiple headings with the same content - disabled
  // because docs intentionally use repeated section headers (What it does,
  // When to use, How, Caveats) across multiple process entries
  "MD024": false,
  
  
  // MD046: Code block style - consistent fenced style
  "MD046": {
    "style": "fenced"
  },

  // MD060: Table column style - disabled because separator rows (|---|) and
  // content rows (| text |) use different spacing by convention in all our docs
  "MD060": false,

  // Relaxed rules for audit prompts and checklists
  "MD022": {
    "lines_above": 0,
    "lines_below": 0
  },
  "MD031": false,
  "MD032": false,
  "MD036": false,
  "MD040": true,
  "MD009": false,
  "MD026": {
    "punctuation": ".,:!?\""
  },
  "MD058": false
}
