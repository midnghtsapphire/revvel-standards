# Keep line endings consistent across contributors and bots.
* text=auto eol=lf

# Append-only files: union-merge so parallel additions never conflict.
CHANGELOG.md            merge=union
CHANGELOG.rst           merge=union
TODO.md                 merge=union
AUTHORS                 merge=union
AUTHORS.md              merge=union
CONTRIBUTORS.md         merge=union
docs/changelog.md       merge=union

# Lockfiles: prefer regeneration over hand-merging.
package-lock.json       merge=ours linguist-generated=true
yarn.lock               merge=ours linguist-generated=true
pnpm-lock.yaml          merge=ours linguist-generated=true
poetry.lock             merge=ours linguist-generated=true
Cargo.lock              merge=ours linguist-generated=true
Gemfile.lock            merge=ours linguist-generated=true
composer.lock           merge=ours linguist-generated=true

# Generated/binary artifacts: never diff, never merge by hand.
*.min.js                binary
*.min.css               binary
*.pdf                   binary
*.png                   binary
*.jpg                   binary
*.jpeg                  binary
*.gif                   binary
*.webp                  binary
*.ico                   binary
*.woff                  binary
*.woff2                 binary
