{
  "request_templates": {
    "github_api": {
      "create_issue": {
        "title": "{{issue_title}}",
        "body": "{{issue_body}}",
        "labels": ["{{labels}}"],
        "assignees": ["{{assignees}}"]
      },
      "create_pr": {
        "title": "{{pr_title}}",
        "body": "{{pr_body}}",
        "head": "{{branch_name}}",
        "base": "{{base_branch}}",
        "draft": false
      },
      "add_comment": {
        "body": "{{comment_text}}"
      }
    },
    "trello_api": {
      "create_card": {
        "name": "{{card_name}}",
        "desc": "{{card_description}}",
        "idList": "{{list_id}}",
        "pos": "top",
        "due": "{{due_date}}",
        "labels": ["{{label_ids}}"]
      },
      "update_card": {
        "name": "{{card_name}}",
        "desc": "{{card_description}}",
        "pos": "{{position}}",
        "closed": false
      },
      "add_comment": {
        "text": "{{comment_text}}"
      }
    },
    "doppler_api": {
      "get_secrets": {
        "project": "{{project}}",
        "config": "{{config}}"
      },
      "create_secret": {
        "project": "{{project}}",
        "config": "{{config}}",
        "name": "{{secret_name}}",
        "value": "{{secret_value}}"
      }
    },
    "vault_api": {
      "read_secret": {
        "path": "{{secret_path}}"
      },
      "write_secret": {
        "path": "{{secret_path}}",
        "data": {
          "{{key}}": "{{value}}"
        }
      },
      "rotate_token": {
        "accessor": "{{accessor}}"
      }
    },
    "openrouter_api": {
      "chat_completion": {
        "model": "{{model}}",
        "messages": [
          {
            "role": "system",
            "content": "{{system_prompt}}"
          },
          {
            "role": "user",
            "content": "{{user_prompt}}"
          }
        ],
        "max_tokens": "{{max_tokens}}",
        "temperature": "{{temperature}}"
      }
    }
  },
  "response_schemas": {
    "github_issue_created": {
      "id": "number",
      "number": "number",
      "html_url": "string",
      "state": "string",
      "title": "string",
      "body": "string"
    },
    "trello_card_created": {
      "id": "string",
      "name": "string",
      "shortUrl": "string",
      "idList": "string",
      "due": "string"
    },
    "doppler_secret_retrieved": {
      "name": "string",
      "value": "string",
      "created_at": "string",
      "updated_at": "string"
    }
  }
}
