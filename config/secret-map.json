      "rotate_provider": "openrouter"
    },
    "ADMIN_GITHUB_TOKEN": {
      "circleci_contexts": ["ai-review-post"],
      "circleci_projects": ["gh/midnghtsapphire/revvel-standards", "gh/midnghtsapphire/linear-a"],
      "rotate_provider": "github"
    },
    "REVVEL_LLM_ALLOW_CLOUD": {
      "circleci_contexts": ["ai-review-llm"],
      "circleci_projects": ["gh/midnghtsapphire/revvel-standards", "gh/midnghtsapphire/linear-a"]
    },
    "NOTION_TOKEN": {
      "circleci_contexts": ["ai-review-llm"],
      "circleci_projects": ["gh/midnghtsapphire/revvel-standards", "gh/midnghtsapphire/linear-a"],
      "rotate_provider": "notion"
    },
    "NOTION_GATE_EXCEPTIONS_DB_ID": {
      "circleci_contexts": ["ai-review-llm"],
      "circleci_projects": ["gh/midnghtsapphire/revvel-standards", "gh/midnghtsapphire/linear-a"]
    }
  },
  "openrouter": [
    [
      "mindmappr",
      "LLM_API_KEY"
    ],
    [
      "revvel-standards",
      "LLM_API_KEY"
    ]
  ],
  "github_pat": [
    [
      "mindmappr",
      "GITHUB_PAT"
    ]
  ],
  "digitalocean": [
    [
      "revvel-standards",
      "DIGITALOCEAN_TOKEN"
    ]
  ],
