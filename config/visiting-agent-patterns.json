{
  "version": 1,
  "rule": "VISITING_AGENTS.md",
  "scope": {
    "include_dirs": [
      "products",
      "packages",
      "templates",
      "projects",
      "growlingeyes",
      "reesereviews",
      "coldtrace",
      "oaudrey",
      "penny-sovereign-yield-scout",
      "fraud-signal-verification-fleet",
      "revvel-rosette-automation",
      "ui",
      "artifacts",
      "install"
    ],
    "extensions": [
      ".html",
      ".htm",
      ".js",
      ".jsx",
      ".mjs",
      ".cjs",
      ".ts",
      ".tsx",
      ".vue",
      ".svelte",
      ".css",
      ".scss"
    ],
    "exclude_globs": [
      "**/node_modules/**",
      "**/*.min.js",
      "**/*.test.*",
      "**/tests/**",
      "**/__tests__/**"
    ]
  },
  "patterns": [
    {
      "id": "manus",
      "regex": "\\bmanus\\b",
      "kind": "branding",
      "why": "Manus name or domain in app code"
    },
    {
      "id": "built-with",
      "regex": "\\b(built with|made with|powered by|generated by|created with)\\b",
      "kind": "branding",
      "why": "agent or tool credit or badge"
    },
    {
      "id": "gtag",
      "regex": "\\bgtag\\(",
      "kind": "tracking",
      "why": "Google Analytics gtag call"
    },
    {
      "id": "googletagmanager",
      "regex": "googletagmanager",
      "kind": "tracking",
      "why": "Google Tag Manager"
    },
    {
      "id": "google-analytics",
      "regex": "google-analytics\\.com|\\bga\\('create'",
      "kind": "tracking",
      "why": "Google Analytics"
    },
    {
      "id": "fbq",
      "regex": "\\bfbq\\(|connect\\.facebook\\.net",
      "kind": "tracking",
      "why": "Meta pixel"
    },
    {
      "id": "utm-source",
      "regex": "utm_source",
      "kind": "marketing",
      "why": "campaign tracking parameter"
    },
    {
      "id": "affiliate",
      "regex": "\\baffiliate",
      "kind": "marketing",
      "why": "affiliate link, id, or code"
    },
    {
      "id": "mixpanel",
      "regex": "mixpanel",
      "kind": "tracking",
      "why": "Mixpanel analytics"
    },
    {
      "id": "segment",
      "regex": "segment\\.io|cdn\\.segment\\.com|analytics\\.load\\(",
      "kind": "tracking",
      "why": "Segment analytics"
    },
    {
      "id": "hotjar",
      "regex": "hotjar",
      "kind": "tracking",
      "why": "Hotjar session recording"
    },
    {
      "id": "posthog",
      "regex": "posthog",
      "kind": "tracking",
      "why": "PostHog analytics"
    },
    {
      "id": "amplitude",
      "regex": "amplitude",
      "kind": "tracking",
      "why": "Amplitude analytics"
    },
    {
      "id": "clarity",
      "regex": "clarity\\.ms",
      "kind": "tracking",
      "why": "Microsoft Clarity"
    },
    {
      "id": "other-pixels",
      "regex": "doubleclick\\.net|analytics\\.tiktok\\.com|snap\\.licdn\\.com|\\bttq\\.",
      "kind": "tracking",
      "why": "third-party ad pixel"
    }
  ],
  "allowlist": [
    {
      "paths": [
        "products/affiliate-hub/**",
        "products/halo-demo-stream/**",
        "packages/static-stripe-server/**",
        "templates/cicd/deploy-static.mjs"
      ],
      "patterns": [
        "affiliate",
        "utm-source"
      ],
      "reason": "affiliate-hub is a product Audrey asked for and affiliate code is its purpose (WR #18342, #18330). The demo kit, the shared Stripe server and the deploy list only name or serve that product."
    },
    {
      "paths": [
        "products/oaudrey-home/public/index.html"
      ],
      "patterns": [
        "affiliate"
      ],
      "reason": "Audrey's own Partner Hub product subdomain; owner-approved exception 2026-11-14 (delegated to MergeMender, PR #18401)."
    }
  ],
