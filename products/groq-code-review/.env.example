# Groq Cloud API key (https://console.groq.com/keys)
# When unset, the app uses the built-in deterministic local reviewer.
GROQ_API_KEY=

# Optional model override (GroqCloud model id)
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Polar.sh checkout for SaaS upsell
NEXT_PUBLIC_POLAR_CHECKOUT_URL=

# Public app URL (used in generated workflow snippets)
NEXT_PUBLIC_APP_URL=http://localhost:3012
