# Perplexity API key (https://www.perplexity.ai/settings/api)
# Required for live mode. Mock mode works without a key.
PERPLEXITY_API_KEY=

# Optional shared secret for API routes.
# Send: Authorization: Bearer <PPLX_APP_TOKEN>  (see README).
# When unset, routes accept requests in development / mock mode only.
PPLX_APP_TOKEN=

# Force mock responses even when PERPLEXITY_API_KEY is set (true|false)
PPLX_FORCE_MOCK=false

# Rate limit: max requests per window per client key
PPLX_RATE_LIMIT_MAX=30
PPLX_RATE_LIMIT_WINDOW_MS=60000

# Default Sonar / Agent model
PPLX_DEFAULT_MODEL=sonar-pro

# Base URL override (default: https://api.perplexity.ai)
PPLX_API_BASE_URL=https://api.perplexity.ai
