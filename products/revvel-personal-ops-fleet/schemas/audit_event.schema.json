{
  "$defs": {
    "Phase": {
      "enum": [
        "plan",
        "dry_run",
        "apply"
      ],
      "title": "Phase",
      "type": "string"
    }
  },
  "description": "Append-only, hash-chained audit record.\n\n``prev_hash`` + ``payload_hash`` -> ``event_hash`` forms a tamper-evident\nchain. ``signature`` is optional and reserved for an external signer; the\nMVP ships hash chaining only and never fabricates a signature.",
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "phase": {
      "$ref": "#/$defs/Phase"
    },
    "event_type": {
      "title": "Event Type",
      "type": "string"
    },
    "actor": {
      "default": "revvel-ops-fleet",
      "title": "Actor",
      "type": "string"
    },
    "identity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Identity"
    },
    "subject_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subject Ref"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "prev_hash": {
      "title": "Prev Hash",
      "type": "string"
    },
    "payload_hash": {
      "default": "",
      "title": "Payload Hash",
      "type": "string"
    },
    "event_hash": {
      "default": "",
      "title": "Event Hash",
      "type": "string"
    },
    "signature": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signature"
    },
    "signer_key_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signer Key Id"
    }
  },
  "required": [
    "sequence",
    "run_id",
    "phase",
    "event_type",
    "prev_hash"
  ],
  "title": "AuditEvent",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revvel.local/schemas/audit_event.schema.json"
}
