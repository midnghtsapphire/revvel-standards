# Revvel Personal Ops Fleet — environment template. NO SECRETS IN THIS FILE.
# Copy to .env locally. .env is gitignored. Real credentials belong in the OS
# keychain / a secret manager, referenced here only by name.

# Autonomy override: review_everything | safe_automation | policy_automation
REVVEL_AUTONOMY_MODE=review_everything

# Apply is refused unless this is explicitly set AND a live adapter exists.
# Leave unset in normal operation.
# REVVEL_ALLOW_APPLY=

# Identity pinning. Must match an allowlisted entry in config/identities.yaml.
REVVEL_DEFAULT_IDENTITY=angelreporters@gmail.com

# Secret *references*, not secrets. Values are looked up from the keychain.
REVVEL_GOOGLE_OAUTH_CLIENT_REF=keychain://revvel/google-oauth-client
REVVEL_GITHUB_TOKEN_REF=keychain://revvel/github-fine-grained-pat
REVVEL_DROPBOX_TOKEN_REF=keychain://revvel/dropbox-app
REVVEL_BOX_TOKEN_REF=keychain://revvel/box-app
REVVEL_N8N_API_KEY_REF=keychain://revvel/n8n-api
REVVEL_OPENROUTER_KEY_REF=keychain://revvel/openrouter

# Local companion pairing (generated per machine, never committed)
REVVEL_COMPANION_ENROLLMENT_REF=keychain://revvel/companion-enrollment

# Optional API bind address (localhost only by design)
REVVEL_API_HOST=127.0.0.1
REVVEL_API_PORT=8787
