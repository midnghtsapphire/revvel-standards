# Music Video Creator — Environment Variables
# NEVER commit a real .env file to git.
# Copy this to .env.local for local development.
# All secrets are stored in HashiCorp Vault (see docs/SECRETS_MANAGEMENT.md).

# ─────────────────────────────────────────────
# OpenRouter — LLM Orchestrator
# Vault path: revvel/shared/llm/openrouter
# Required for: deep research, planning, provider selection, metadata generation
# ─────────────────────────────────────────────
OPENROUTER_API_KEY=

# ─────────────────────────────────────────────
# Video Generation Providers
# Vault path: revvel/shared/video/
# ─────────────────────────────────────────────

# HeyGen — Lip-sync avatar video generation
# https://docs.heygen.com → API Settings
HEYGEN_API_KEY=
# HEYGEN_TEST_MODE: set to "true" to generate watermarked preview videos (development only).
# When unset or set to any other value, production (non-watermarked) mode is used.
HEYGEN_TEST_MODE=

# Luma Dream Machine — AI video generation
# https://lumaai.com → API Settings
LUMA_API_KEY=

# Runway Gen-3 — AI video generation
# https://runwayml.com → API Settings
RUNWAY_API_KEY=

# ─────────────────────────────────────────────
# Storage — for persisting generated MP4s
# Vault path: revvel/shared/storage/
# ─────────────────────────────────────────────
STORAGE_BUCKET_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

# ─────────────────────────────────────────────
# Publication — meetaudreyevans.com
# Vault path: revvel/apps/meetaudreyevans/deploy
# ─────────────────────────────────────────────
PUBLISH_WEBHOOK_URL=
PUBLISH_API_KEY=

# ─────────────────────────────────────────────
# API Security
# Vault path: revvel/apps/music-video-creator/auth
# ─────────────────────────────────────────────
# Optional: set MUSIC_VIDEO_API_KEY to require x-api-key header on /api/video
# and /api/orchestrate. If unset, the endpoints run in dev mode (no auth required).
MUSIC_VIDEO_API_KEY=

# ─────────────────────────────────────────────
# Vercel Deployment (set as GitHub Actions secrets)
# ─────────────────────────────────────────────
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
