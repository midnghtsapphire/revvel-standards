# Public Stripe Payment Link for the $99/month REVVEL Pro subscription.
# Must use https://buy.stripe.com or https://checkout.stripe.com.
# Set at BUILD time; static exports cannot read runtime environment changes.
# Leave empty to keep paid checkout unavailable rather than showing a broken link.
NEXT_PUBLIC_STRIPE_CHECKOUT_URL=

# Runtime Checkout Session (read by server/static-stripe-server.mjs, not by the browser bundle).
# STRIPE_MODE defaults to test. Leave the secrets empty in git.
# A sk_live_ value is refused while STRIPE_MODE=test.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Optional. When set, Checkout success and cancel URLs use this origin.
# Example: https://affiliate-hub.revvel.co
PUBLIC_BASE_URL=
