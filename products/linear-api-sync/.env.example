# Linear personal API key (Settings → API → Personal API keys).
# Header value is sent as Authorization: <key>
LINEAR_API_KEY=

# Optional Linear workflow state UUID for "Done" (or equivalent).
# When unset, the sync only posts a comment and does not change state.
LINEAR_DONE_STATE_ID=

# Optional shared secret for POST /api/github-commit-receiver.
# Send the same value in Authorization: ****** or x-linear-sync-secret.
GITHUB_WEBHOOK_SECRET=
