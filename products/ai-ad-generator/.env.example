# Required for AI ad copy generation (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-...

# Optional: override the AI model used for ad generation
# Default: anthropic/claude-haiku-3 (cheap, fast)
OPENROUTER_MODEL=anthropic/claude-haiku-3

# Optional: site URL sent to OpenRouter for ranking
NEXT_PUBLIC_SITE_URL=http://localhost:3009
