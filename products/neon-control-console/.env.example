# Neon Control Console — environment variables (names only; never commit values)
#
# Live mode: set NEON_API_KEY (and optionally NEON_PROJECT_ID).
# Demo mode: leave NEON_API_KEY empty — the UI serves fixture projects/branches.

# Required for live Neon API calls (server-side only).
NEON_API_KEY=

# Optional default project when listing branches / generating CLI snippets.
NEON_PROJECT_ID=

# Override only for tests or self-hosted API stubs.
# NEON_API_HOST=https://console.neon.tech/api/v2
