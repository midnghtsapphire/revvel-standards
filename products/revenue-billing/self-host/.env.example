# Lago self-host settings. Copy to `.env` (git-ignored) and fill in YOUR values.
# This file holds NAMES ONLY. Never commit a filled-in .env, and never paste
# these values into chat, an issue, a PR or a log. Keep real values in the vault.
#
# Generate each secret locally (commands from the official Lago docs):
#   SECRET_KEY_BASE                       openssl rand -hex 64
#   LAGO_RSA_PRIVATE_KEY                  openssl genrsa 2048 | base64 | tr -d '\n'
#   LAGO_ENCRYPTION_*  (each of the 3)    LC_ALL=C tr -dc 'a-zA-Z0-9' < /dev/urandom | head -c 32; echo
#   POSTGRES_PASSWORD                     LC_ALL=C tr -dc 'a-zA-Z0-9' < /dev/urandom | head -c 32; echo
#
# docker compose refuses to start while any REQUIRED value below is empty.

# --- REQUIRED secrets (leave blank here; set in your private .env) ---
POSTGRES_PASSWORD=
SECRET_KEY_BASE=
LAGO_RSA_PRIVATE_KEY=
LAGO_ENCRYPTION_PRIMARY_KEY=
LAGO_ENCRYPTION_DETERMINISTIC_KEY=
LAGO_ENCRYPTION_KEY_DERIVATION_SALT=

# --- Non-secret settings with safe defaults ---
POSTGRES_USER=lago
POSTGRES_DB=lago
# Public URLs. The defaults are for a local trial only; behind a TLS proxy set
# both to the https:// addresses you serve.
LAGO_API_URL=http://localhost:3000
LAGO_FRONT_URL=http://localhost
API_PORT=3000
FRONT_PORT=80
# Set to true AFTER you have created the one admin organization.
LAGO_DISABLE_SIGNUP=false

# --- Optional email (Lago invoices by email); blank = email disabled ---
LAGO_FROM_EMAIL=
LAGO_SMTP_ADDRESS=
LAGO_SMTP_PORT=587
LAGO_SMTP_USERNAME=
LAGO_SMTP_PASSWORD=
