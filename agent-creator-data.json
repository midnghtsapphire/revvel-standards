  },
  "fleet": {
    "name": "agentic-workflow-fleet",
    "version": "0.1.0",
    "initial_scope": "AI workflow automation specialist engagements only",
    "charter": {
      "essential_skills": [
        "Python or JavaScript automation scripting",
        "Workflow platforms: n8n, Make (Integromat), Zapier, Pipedream, Power Automate",
        "APIs and integration techniques to connect applications",
        "Data analysis and visualization of workflow metrics",
        "Problem-solving: find inefficiencies, propose automations",
        "Stakeholder communication"
      ],
      "operating_rules": [
        "Design for failure first: retries, idempotency, dead-letter handling",
        "Force structured output (JSON mode / function calling); never parse free-form model text in production",
        "Human-in-the-loop until accuracy is proven, then loosen",
        "Instrument cost and latency per step; spend guards and circuit breakers at the workflow level",
        "Prompts live in a versioned registry, separate from code",
        "Test prompt changes against a regression set built from real failures"
      ]
    },
    "domains": [
      "Marketing & Revenue Ops Automation",
      "Customer Support Automation",
      "Sales Operations Automation",
      "Finance & Back-Office Automation",
      "Product & Internal Tools Automation",
      "Agentic Workflow Engineering"
    ],
    "agents": [
      {
        "handle": "chain",
        "name": "Chainwright",
        "pattern": "Prompt Chaining",
        "group": "Sequential Intelligence",
        "job": "Decomposes a complex task into sequential LLM steps where each call processes the output of the previous one. Owns chatbot-style flows and agent tool pipelines. Does nothing else.",
        "use_for": [
          "prompt chain",
          "step-by-step",
          "sequential pipeline",
          "chatbot flow"
        ]
      },
      {
        "handle": "planner",
        "name": "Wayfinder",
        "pattern": "Plan and Execute",
        "group": "Sequential Intelligence",
        "job": "Creates a multi-step plan, executes it sequentially, reviews after each task, and adjusts the remaining plan. Owns business-process automation and data-pipeline orchestration. Does nothing else.",
        "use_for": [
          "plan and execute",
          "multi-step plan",
          "process automation",
          "pipeline orchestration"
        ]
      },
      {
        "handle": "fanout",
        "name": "Manifold",
        "pattern": "Parallelization",
        "group": "Parallel Processing",
        "job": "Sections a task or runs it multiple times simultaneously and aggregates the outputs. Owns automated evaluations and guardrail voting. Does nothing else.",
        "use_for": [
          "parallelization",
          "fan-out",
          "aggregate outputs",
          "evals",
          "guardrails"
        ]
      },
      {
        "handle": "conductor",
        "name": "Maestro",
        "pattern": "Orchestrator-Worker",
        "group": "Parallel Processing",
        "job": "Acts as the central brain that dynamically breaks a task down, delegates to worker agents, and synthesizes their results. Owns agentic RAG and coding-agent coordination. Does nothing else.",
        "use_for": [
          "orchestrator",
          "delegate",
          "worker agents",
          "synthesize results",
          "agentic rag"
        ]
      },
      {
        "handle": "switchboard",
        "name": "Switchyard",
        "pattern": "Routing",
        "group": "Intelligent Routing",
        "job": "Classifies every input and directs it to the right specialized handler, keeping concerns separated. Owns support-ticket triage and multi-agent hand-offs. Does nothing else.",
        "use_for": [
          "routing",
          "classify",
          "triage",
          "direct to specialist",
          "separation of concerns"
        ]
      },
      {
        "handle": "critic",
        "name": "Whetstone",
        "pattern": "Evaluator-Optimizer",
        "group": "Intelligent Routing",
        "job": "Runs the generate-evaluate loop: one model produces, it evaluates and feeds back until quality clears the bar. Owns real-time output monitoring and coding-agent review loops. Does nothing else.",
        "use_for": [
          "evaluator",
          "optimizer",
          "feedback loop",
          "quality bar",
          "llm judge"
        ]
      },
      {
        "handle": "mirror",
        "name": "Looking Glass",
        "pattern": "Reflection",
        "group": "Self-Improving Systems",
        "job": "Reviews its own (and fleet) task responses via self-reflection and feedback to improve final quality over time. Owns post-run retros and failure-pattern learning. Does nothing else.",
        "use_for": [
          "reflection",
          "self-review",
          "retro",
          "learn from failures"
        ]
      },
      {
        "handle": "rewoo",
        "name": "Deepcut",
        "pattern": "ReWOO",
        "group": "Self-Improving Systems",
        "job": "Plans with substitution up front (ReWOO) to cut token use versus ReACT-style loops. Owns deep-search agents and multi-step question answering. Does nothing else.",
        "use_for": [
          "rewoo",
          "deep search",
          "multi-step qa",
          "token efficiency",
          "plan with substitution"
        ]
      },
      {
        "handle": "loop",
        "name": "Perpetua",
        "pattern": "Autonomous Workflow",
        "group": "Self-Improving Systems",
        "job": "Runs as a continuous LLM loop acting on tool feedback, inside guardrails and spend caps. Owns long-running autonomous automations and self-healing flows. Does nothing else.",
        "use_for": [
          "autonomous loop",
          "tool feedback",
          "continuous",
          "self-healing",
          "always-on"
        ]
      }
    ]
  },
