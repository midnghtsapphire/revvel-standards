{
  "@context": "https://schema.org",
  "@type": "ResearchProject",
  "name": "{{PROJECT_NAME}}",
  "description": "{{DESCRIPTION}}",
  "url": "{{PROJECT_URL}}",
  "identifier": "{{PROJECT_SLUG}}",
  "startDate": "{{START_DATE}}",
  "status": "{{STATUS}}",
  "founder": {
    "@type": "Person",
    "name": "{{FOUNDER_NAME}}",
    "url": "{{FOUNDER_URL}}"
  },
  "member": [
    {
      "@type": "Person",
      "name": "{{FOUNDER_NAME}}",
      "roleName": "Lead Developer"
    }
  ],
  "about": [
    {{#each CATEGORIES}}
    {
      "@type": "Thing",
      "name": "{{this}}"
    }{{#unless @last}},{{/unless}}
    {{/each}}
  ],
  "keywords": [
    {{#each TECH_STACK}}
    "{{this}}"{{#unless @last}},{{/unless}}
    {{/each}}
  ],
  "mainEntity": {
    "@type": "SoftwareSourceCode",
    "name": "{{PROJECT_NAME}}",
    "description": "{{ONE_LINE_PITCH}}",
    "codeRepository": "{{GITHUB_URL}}",
    "programmingLanguage": [
      {{#each LANGUAGES}}
      {
        "@type": "ComputerLanguage",
        "name": "{{this}}"
      }{{#unless @last}},{{/unless}}
      {{/each}}
    ],
    "runtimePlatform": "{{RUNTIME}}",
    "license": "{{LICENSE}}"
  },
  "result": [
    {{#each OUTCOMES}}
    {
      "@type": "Thing",
      "description": "{{this}}"
    }{{#unless @last}},{{/unless}}
    {{/each}}
  ],
  "funding": {
    "@type": "Grant",
    "funder": {
      "@type": "Organization",
      "name": "{{ORGANIZATION_NAME}}"
    }
  },
  "isRelatedTo": [
    {{#each RELATED_PROJECTS}}
    {
      "@type": "ResearchProject",
      "name": "{{name}}",
      "url": "{{url}}"
    }{{#unless @last}},{{/unless}}
    {{/each}}
  ],
  "hasPart": [
    {
      "@type": "CreativeWork",
      "name": "Project Documentation",
      "url": "{{PROJECT_URL}}/blob/main/README.md"
    },
    {
      "@type": "CreativeWork",
      "name": "Source Code",
      "url": "{{PROJECT_URL}}"
    }
  ]
}
