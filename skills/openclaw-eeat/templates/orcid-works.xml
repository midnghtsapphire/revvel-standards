<?xml version="1.0" encoding="UTF-8"?>
<work:work xmlns:common="http://www.orcid.org/ns/common"
           xmlns:work="http://www.orcid.org/ns/work"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://www.orcid.org/ns/work https://raw.githubusercontent.com/ORCID/ORCID-Source/master/orcid-model/src/main/resources/record_3.0/work-3.0.xsd">
    
    <!-- Work Title -->
    <work:title>
        <common:title>{{WORK_TITLE}}</common:title>
        <common:subtitle>{{WORK_SUBTITLE}}</common:subtitle>
    </work:title>
    
    <!-- Journal/Publication Title (if applicable) -->
    {{#if JOURNAL_TITLE}}
    <work:journal-title>{{JOURNAL_TITLE}}</work:journal-title>
    {{/if}}
    
    <!-- Short Description -->
    <work:short-description>{{SHORT_DESCRIPTION}}</work:short-description>
    
    <!-- Citation (optional but recommended) -->
    {{#if CITATION}}
    <work:citation>
        <work:citation-type>{{CITATION_TYPE}}</work:citation-type>
        <work:citation-value>{{CITATION_VALUE}}</work:citation-value>
    </work:citation>
    {{/if}}
    
    <!-- Work Type -->
    <work:type>{{WORK_TYPE}}</work:type>
    <!-- 
    Common work types for software/OSINT projects:
    - online-resource
    - other
    - software
    - research-tool
    - data-set
    -->
    
    <!-- Publication Date -->
    {{#if PUBLICATION_DATE}}
    <common:publication-date>
        <common:year>{{PUBLICATION_YEAR}}</common:year>
        <common:month>{{PUBLICATION_MONTH}}</common:month>
        <common:day>{{PUBLICATION_DAY}}</common:day>
    </common:publication-date>
    {{/if}}
    
    <!-- External Identifiers -->
    <common:external-ids>
        {{#if DOI}}
        <common:external-id>
            <common:external-id-type>doi</common:external-id-type>
            <common:external-id-value>{{DOI}}</common:external-id-value>
            <common:external-id-url>https://doi.org/{{DOI}}</common:external-id-url>
            <common:external-id-relationship>self</common:external-id-relationship>
        </common:external-id>
        {{/if}}
        
        {{#if ISBN}}
        <common:external-id>
            <common:external-id-type>isbn</common:external-id-type>
            <common:external-id-value>{{ISBN}}</common:external-id-value>
            <common:external-id-relationship>self</common:external-id-relationship>
        </common:external-id>
        {{/if}}
        
        <!-- GitHub repository as identifier -->
        {{#if GITHUB_URL}}
        <common:external-id>
            <common:external-id-type>uri</common:external-id-type>
            <common:external-id-value>{{GITHUB_URL}}</common:external-id-value>
            <common:external-id-url>{{GITHUB_URL}}</common:external-id-url>
            <common:external-id-relationship>self</common:external-id-relationship>
        </common:external-id>
        {{/if}}
        
        <!-- Archive.org identifier if available -->
        {{#if ARCHIVE_ORG_ID}}
        <common:external-id>
            <common:external-id-type>uri</common:external-id-type>
            <common:external-id-value>https://archive.org/details/{{ARCHIVE_ORG_ID}}</common:external-id-value>
            <common:external-id-url>https://archive.org/details/{{ARCHIVE_ORG_ID}}</common:external-id-url>
            <common:external-id-relationship>self</common:external-id-relationship>
        </common:external-id>
        {{/if}}
    </common:external-ids>
    
    <!-- Work URL -->
    <common:url>{{WORK_URL}}</common:url>
    
    <!-- Contributors -->
    <work:contributors>
        {{#each CONTRIBUTORS}}
        <work:contributor>
            <work:credit-name>{{name}}</work:credit-name>
            <work:contributor-orcid>
                {{#if orcid}}
                <common:uri>https://orcid.org/{{orcid}}</common:uri>
                <common:path>{{orcid}}</common:path>
                {{/if}}
            </work:contributor-orcid>
            <work:contributor-attributes>
                <work:contributor-role>{{role}}</work:contributor-role>
            </work:contributor-attributes>
        </work:contributor>
        {{/each}}
    </work:contributors>
    
    <!-- Language Code -->
    <common:language-code>{{LANGUAGE_CODE}}</common:language-code>
    <!-- ISO 639-1 code, e.g., "en" for English -->
    
    <!-- Country -->
    {{#if COUNTRY}}
    <common:country>{{COUNTRY}}</common:country>
    <!-- ISO 3166-1 alpha-2 code, e.g., "US" -->
    {{/if}}
    
</work:work>
