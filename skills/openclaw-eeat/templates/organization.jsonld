{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "{{ORGANIZATION_NAME}}",
  "legalName": "{{LEGAL_NAME}}",
  "url": "{{PRIMARY_URL}}",
  "logo": "{{LOGO_URL}}",
  "description": "{{TAGLINE}}",
  "foundingDate": "{{FOUNDING_DATE}}",
  "founder": {
    "@type": "Person",
    "name": "{{FOUNDER_NAME}}",
    "sameAs": [
      "{{GITHUB_URL}}",
      "{{ORCID_URL}}"
    ]
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "{{CITY}}",
    "addressRegion": "{{STATE}}",
    "addressCountry": "{{COUNTRY}}"
  },
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "contactType": "general inquiry",
      "email": "{{CONTACT_EMAIL}}",
      "availableLanguage": "English"
    }
  ],
  "sameAs": [
    "{{GITHUB_URL}}",
    "{{ORCID_URL}}",
    "{{WIKIDATA_URL}}",
    "{{CRUNCHBASE_URL}}"
  ],
  "knowsAbout": [
    {{#each EXPERTISE_AREAS}}
    "{{this}}"{{#unless @last}},{{/unless}}
    {{/each}}
  ],
  "areaServed": {
    "@type": "GeoShape",
    "addressCountry": ["US", "International"]
  },
  "slogan": "{{TAGLINE}}",
  "memberOf": [
    {
      "@type": "Organization",
      "name": "MISP Community",
      "url": "https://www.misp-project.org/"
    },
    {
      "@type": "Organization",
      "name": "Bellingcat Community",
      "url": "https://www.bellingcat.com/"
    }
  ]
}
