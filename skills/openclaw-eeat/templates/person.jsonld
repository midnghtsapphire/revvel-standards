{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "{{PERSON_NAME}}",
  "givenName": "{{GIVEN_NAME}}",
  "familyName": "{{FAMILY_NAME}}",
  "jobTitle": "{{JOB_TITLE}}",
  "description": "{{BIO}}",
  "url": "{{PRIMARY_URL}}",
  "image": "{{PHOTO_URL}}",
  "sameAs": [
    "{{GITHUB_URL}}",
    "{{ORCID_URL}}",
    "{{WIKIDATA_URL}}",
    "{{LINKEDIN_URL}}",
    "{{RESEARCHGATE_URL}}"
  ],
  "knowsAbout": [
    {{#each EXPERTISE_AREAS}}
    {
      "@type": "Thing",
      "name": "{{this}}"
    }{{#unless @last}},{{/unless}}
    {{/each}}
  ],
  "hasCredential": [
    {{#each CREDENTIALS}}
    {
      "@type": "EducationalOccupationalCredential",
      "name": "{{this}}"
    }{{#unless @last}},{{/unless}}
    {{/each}}
  ],
  "worksFor": {
    "@type": "Organization",
    "name": "{{ORGANIZATION_NAME}}",
    "url": "{{ORG_URL}}"
  },
  "alumniOf": [
    {{#each EDUCATION}}
    {
      "@type": "Organization",
      "name": "{{institution}}",
      "url": "{{url}}"
    }{{#unless @last}},{{/unless}}
    {{/each}}
  ],
  "affiliation": [
    {
      "@type": "Organization",
      "name": "Search and Rescue Volunteer",
      "description": "{{SAR_DESCRIPTION}}"
    },
    {
      "@type": "Organization",
      "name": "OSINT Community",
      "url": "https://osintcommunity.org/"
    }
  ],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "{{CITY}}",
    "addressRegion": "{{STATE}}",
    "addressCountry": "{{COUNTRY}}"
  },
  "nationality": {
    "@type": "Country",
    "name": "{{NATIONALITY}}"
  },
  "award": [
    {{#each AWARDS}}
    "{{this}}"{{#unless @last}},{{/unless}}
    {{/each}}
  ]
}
