@@ -0,0 +1,62 @@
+name: Jules PR Reviewer
+
+on:
+  pull_request:
+    types: [opened, synchronize, reopened, ready_for_review]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+  pull-requests: write
+  statuses: write
+
+concurrency:
+  group: jules-review-${{ github.event.pull_request.number || github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  review:
+    name: Jules PR review
+    runs-on: ubuntu-latest
+    env:
+      JULES_API_KEY: ${{ secrets.JULES_API_KEY }}
+    steps:
+      - name: Verify JULES_API_KEY is configured
+        run: |
+          if [ -z "${JULES_API_KEY}" ]; then
+            echo "::warning::JULES_API_KEY is not set — skipping Jules PR Reviewer."
+          else
+            echo "JULES_API_KEY is configured."
+          fi
+
+      - name: Jules PR Review
+        if: ${{ env.JULES_API_KEY != '' && env.JULES_API_KEY != null }}
+        uses: sanjay3290/jules-pr-reviewer@v1.0.0
+        with:
+          jules_api_key: ${{ secrets.JULES_API_KEY }}
+          github_token: ${{ secrets.GITHUB_TOKEN }}
+          fail_on: blocking
+          skip_drafts: true
+          skip_forks: true
+          bypass_label: jules-override
+          status_context: jules/review
+
+      - name: Mark Jules review status as skipped
+        if: ${{ env.JULES_API_KEY == '' || env.JULES_API_KEY == null }}
+        uses: actions/github-script@v7
+        with:
+          script: |
+            const sha = context.payload.pull_request?.head?.sha;
+            if (!sha) {
+              core.info('No pull_request head SHA (workflow_dispatch?) — nothing to status.');
+              return;
+            }
+            await github.rest.repos.createCommitStatus({
+              owner: context.repo.owner,
+              repo: context.repo.repo,
+              sha,
+              state: 'success',
+              context: 'jules/review',
+              description: 'Skipped: JULES_API_KEY is not configured',
+              target_url: `${context.serverUrl}/${context.repo.owner}/${context.repo.repo}/actions/runs/${context.runId}`
+            });
