# Copy to /etc/shci/shci.env (mode 600). Secret values live in their own files.
REPO_FULL_NAME=midnghtsapphire/revvel-standards
WEBHOOK_SECRET=paste-contents-of-/etc/shci/webhook-secret
GITHUB_TOKEN_FILE=/etc/shci/github-token
ADMIN_TOKEN_FILE=/etc/shci/admin-token
SECRETS_FILE=/etc/shci/secrets.env
PORT=8080
MAX_CONCURRENCY=2
JOB_TIMEOUT_MIN=30
# Login that owns GITHUB_TOKEN, so the dispatcher ignores its own activity.
IGNORE_SENDERS=
WORK_DIR=/home/shci/work
LOG_DIR=/home/shci/logs
# Start narrow, then widen:
# ONLY_WORKFLOWS=python-flake8.yml,lint-md.yml
